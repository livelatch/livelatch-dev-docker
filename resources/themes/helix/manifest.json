  "presets": {
    "bio":     { "aColor": "#36e0ff", "bColor": "#ff5ea8", "bgColor": "#04060f", "textColor": "#eaf6ff", "intensity": 50, "speed": 50 },
    "emerald": { "aColor": "#7dffb0", "bColor": "#2de2e6", "bgColor": "#02120c", "textColor": "#e6fff0", "intensity": 52, "speed": 48 },
    "gold":    { "aColor": "#ffe06a", "bColor": "#ff8a3c", "bgColor": "#0c0800", "textColor": "#fff4d6", "intensity": 50, "speed": 46 },
    "violet":  { "aColor": "#9b8bff", "bColor": "#ff6ad5", "bgColor": "#07051a", "textColor": "#efeaff", "intensity": 52, "speed": 50 },
    "mono":    { "aColor": "#d6dcec", "bColor": "#8a90a0", "bgColor": "#06070b", "textColor": "#f3f5fa", "intensity": 46, "speed": 44 }
  },
  "controls": {
