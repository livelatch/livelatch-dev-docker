  "presets": {
    "meadow":  { "aColor": "#ffe39a", "bColor": "#9be86a", "bgColor": "#06100a", "textColor": "#eafff0", "intensity": 50, "speed": 50 },
    "winter":  { "aColor": "#dff0ff", "bColor": "#8fb6ff", "bgColor": "#040a14", "textColor": "#eaf4ff", "intensity": 48, "speed": 42 },
    "ember":   { "aColor": "#ffb86a", "bColor": "#ff5e3a", "bgColor": "#100602", "textColor": "#ffeede", "intensity": 54, "speed": 48 },
    "lagoon":  { "aColor": "#9ffce0", "bColor": "#2de2c0", "bgColor": "#02120f", "textColor": "#e6fff8", "intensity": 50, "speed": 46 },
    "violet":  { "aColor": "#e6c2ff", "bColor": "#9b6aff", "bgColor": "#0a0614", "textColor": "#f2eaff", "intensity": 50, "speed": 46 }
  },
  "controls": {
