{
  "name": "Portal",
  "slug": "portal",
  "author": "livelatch",
  "version": "1.0.0",
  "description": "An immersive 3D portal with a rotating energy ring and drifting particle cloud, built with Three.js and GSAP.",
  "preview_gradient": "linear-gradient(135deg, #0d001a, #8b5cf6)",
  "libraries": ["three", "gsap"],
  "defaults": {
    "portalColor": "#8b5cf6",
    "accentColor": "#0ce5de",
    "textColor": "#ffffff",
    "particleCount": 800,
    "animationSpeed": 60
  },
  "presets": {
    "default": {
      "portalColor": "#8b5cf6",
      "accentColor": "#0ce5de",
      "textColor": "#ffffff",
      "particleCount": 800,
      "animationSpeed": 60
    },
    "neon": {
      "portalColor": "#00ff88",
      "accentColor": "#ff00aa",
      "textColor": "#ffffff",
      "particleCount": 1200,
      "animationSpeed": 80
    },
    "fire": {
      "portalColor": "#ff4500",
      "accentColor": "#ff8c00",
      "textColor": "#fff8f0",
      "particleCount": 600,
      "animationSpeed": 70
    },
    "ice": {
      "portalColor": "#00d4ff",
      "accentColor": "#ffffff",
      "textColor": "#e0f8ff",
      "particleCount": 500,
      "animationSpeed": 40
    }
  },
  "controls": {
    "colours": [
      { "key": "portalColor", "label": "Portal colour" },
      { "key": "accentColor", "label": "Particle colour" },
      { "key": "textColor",   "label": "Text colour" }
    ],
    "sliders": {
      "particleCount":  { "label": "Particle density", "min": 100,  "max": 2000, "step": 100, "default": 800 },
      "animationSpeed": { "label": "Animation speed",  "min": 0,    "max": 100,  "step": 1,   "default": 60  }
    }
  }
}
